{
  "name": "laboratorio-quimica-3d",
  "private": true,
  "version": "0.4.0",
  "description": "Laboratorio de química 3D: tabla periódica, estructura atómica, biblioteca molecular y enlaces",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "data:elements": "node scripts/build-elements.mjs",
    "data:fetch": "node scripts/fetch-sources.mjs",
    "data:structures": "node scripts/build-structures.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
